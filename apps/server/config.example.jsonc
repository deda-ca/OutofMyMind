// Jarvis's settings. Copy to config.jsonc (git ignores it) and set what you need; every setting is
// here with what it does, commented out at its default. "${NAME}" in a value is taken from the environment.
{
  "$schema": "./config.schema.json",

  // Who Jarvis works for.
  "owner": {
    // Your name, so Jarvis knows who it works for.
    // "name": ""
  },

  // The API server: where it listens, who may call it, HTTPS.
  "server": {
    // The address to listen on: 127.0.0.1 (this machine only) unless deliberately opened up.
    // "host": "127.0.0.1"
    // The port to listen on.
    // "port": 5180
    // Browser origins allowed to call the API. Add this machine's LAN address to use Jarvis from a phone, e.g. https://192.168.1.50:5173.
    // "allowedOrigins": ["https://127.0.0.1:5173","https://localhost:5173"]
    // The pass-key for signing in. Unset: one is generated and kept in the data folder (access-key). (secret)
    // "accessKey": ""
    // HTTPS: off (under Node, Vite serves HTTPS in front), or self-signed (a certificate made once). The release binary defaults to self-signed. One of: off, self-signed.
    // "tls": "off"
    // Your own certificate (PEM), with tlsKey: overrides tls.
    // "tlsCert": ""
    // Your certificate's private key (PEM).
    // "tlsKey": ""
    // The built web client to serve at /. Unset: not served (in development Vite serves it; the release binary sets it).
    // "siteDir": ""
    // How much the server logs. One of: fatal, error, warn, info, debug, trace.
    // "logLevel": "info"
  },

  // Where Jarvis keeps its data and your files.
  "data": {
    // The database, audio archive and everything Jarvis keeps (relative to apps/server). Private conversations: never commit it.
    // "dir": "data"
    // The folder Jarvis's file tools work in (to-dos, lists, notes, …). Default: <data.dir>/workspace.
    // "workspace": ""
    // Keep the data folder in git, committing every change (any change can be undone).
    // "history": true
    // Which plugins are on (the LLM's tools).
    // "plugins": "mcp.json"
  },

  // The LLMs Jarvis answers with. One connection (url, model, apiKey below), or several in "connections": each agent picks "connection/model".
  "llm": {
    // With several connections: the model agents use unless they pick one, as "connection/model" (e.g. "local/Assistant"). Default: the first connection's model.
    // "default": ""
    // The OpenAI-compatible chat endpoint (llama.cpp's llama-server, or a hosted service).
    // "url": "http://127.0.0.1:5454"
    // The model name to ask for.
    // "model": "Assistant"
    // Sent as "Authorization: Bearer …" (a hosted service, or llama-server --api-key). (secret)
    // "apiKey": ""
    // The model can see images (llama.cpp with --mmproj): photos you add are sent to it.
    // "vision": false
    // Several LLM connections (when set, the url, model, apiKey and vision above are not used: make your local server one of these).
    // "connections": [
    //   { "id": "local", "kind": "openai", "url": "http://127.0.0.1:5454", "model": "Assistant", "llamaCpp": true, "vision": true },
    //   { "id": "anthropic", "kind": "anthropic", "apiKey": "${ANTHROPIC_API_KEY}", "model": "claude-opus-5-5" },
    //   { "id": "openai", "kind": "openai", "url": "https://api.openai.com", "apiKey": "${OPENAI_API_KEY}", "model": "gpt-5" },
    //   { "id": "grok", "kind": "openai", "url": "https://api.x.ai", "apiKey": "${XAI_API_KEY}", "model": "grok-4" }
    // ]
  },

  // Speech: audio.cpp for transcription and text-to-speech, and the voiceprint model.
  "audio": {
    // audio.cpp, for transcription and text-to-speech.
    // "url": "http://127.0.0.1:5552"
    // The transcription model on audio.cpp.
    // "asrModel": "Qwen3-ASR"
    // The text-to-speech model on audio.cpp.
    // "ttsModel": "Qwen3-TTS"
    // Jarvis's voice (agents can have their own).
    // "ttsVoice": "jarvis"
    // The voiceprint model for speaker recognition (npm run fetch-models). Missing: recognition is off.
    // "voiceprintModel": "models/3dspeaker_speech_campplus_sv_en_voxceleb_16k.onnx"
  },

  // Background services Jarvis writes for itself (docs/services.md).
  "services": {
    // Background services on.
    // "enabled": true
    // LLM turns services' (and plugins') events may start in a day, all together.
    // "dailyTurns": 200
    // "host:port" services may reach although they resolve to a private address (a device at home).
    // "localHosts": []
  },

  // Scripts Jarvis runs (the scripts plugin), and the Node.js used for them and for services.
  "scripts": {
    // The Node.js 24 that runs scripts and services. Unset: the first node on PATH.
    // "node": ""
    // The longest a script may run.
    // "timeoutSeconds": ""
    // The most memory a script may use.
    // "memoryMb": ""
  },

  // Web search and the browser Jarvis uses (the web and browser plugins).
  "web": {
    // Which search engine the web plugin uses (see plugins/README.md).
    // "searchEngine": ""
    // For Brave Search. (secret)
    // "braveApiKey": ""
    // Your SearXNG instance.
    // "searxngUrl": ""
    // The browser the browser plugin drives. Unset: Chrome's usual place.
    // "browserExecutable": ""
    // Run it without a window.
    // "browserHeadless": ""
    // Its remote-debugging port.
    // "browserPort": ""
  },

  // The weather plugin.
  "weather": {
    // Where you live, used when no place is named, e.g. "Ottawa, Ontario, Canada".
    // "home": ""
    // celsius (default) or fahrenheit. One of: celsius, fahrenheit.
    // "units": ""
  },

  // The phone line through VoIP.ms: calls, Marvin answering, texts (docs/phone.md).
  "phone": {
    // The phone line on (when the SIP settings are there).
    // "enabled": true
    // The nearest VoIP.ms server, e.g. toronto.voip.ms.
    // "sipServer": ""
    // Jarvis's VoIP.ms sub-account, e.g. 123456_jarvis.
    // "sipUser": ""
    // The sub-account's password. (secret)
    // "sipPassword": ""
    // Jarvis's phone number (10 digits).
    // "did": ""
    // Caller ID on calls placed for you (your cell, verified at VoIP.ms). Empty: the DID.
    // "callerId": ""
    // Your cell: where Marvin rings you.
    // "ownerCell": ""
    // For texts: your VoIP.ms login email.
    // "apiUser": ""
    // For texts: the API password (not the login password). (secret)
    // "apiPassword": ""
    // The bearer token from VoIP.ms's API page. (secret)
    // "apiToken": ""
    // What the assistant calls itself when it answers the phone.
    // "assistantName": "Marvin"
    // The longest call.
    // "maxCallMinutes": 120
    // Outgoing minutes a day, all calls together.
    // "dailyMinutes": 180
    // Texts Jarvis may send a day.
    // "dailyTexts": 50
    // How often to check for new texts.
    // "textPollSeconds": 30
    // How long an incoming call rings your screens before Marvin answers.
    // "ringSeconds": 30
  },

  // Telegram: chat with Jarvis from your phone, and Jarvis messages you there (docs/telegram.md).
  "telegram": {
    // Chatting from Telegram on (when the bot token and chat are set; sending works regardless).
    // "enabled": true
    // The bot token from @BotFather (a bot Jarvis alone uses). (secret)
    // "botToken": ""
    // Your chat with the bot.
    // "ownerChatId": ""
    // Replies as a voice note too: always, only to voice notes, or never. One of: always, voice, off.
    // "voiceReplies": "always"
  },

  // The email plugin: the inbox Jarvis watches and sends from (docs/email.md).
  "email": {
    // The IMAP server.
    // "imapHost": ""
    // Its port (993: TLS).
    // "imapPort": 993
    // The SMTP server (default: the IMAP server).
    // "smtpHost": ""
    // Its port (465: TLS; 587: STARTTLS).
    // "smtpPort": 465
    // The login (usually the address).
    // "user": ""
    // The password (an app password where the provider requires one). (secret)
    // "password": ""
    // The From address (default: the login).
    // "address": ""
    // The name shown with it.
    // "fromName": ""
    // How far back to save mail on the first start.
    // "historyDays": 30
  },

  // The calendar plugin: a CalDAV calendar (docs/calendar.md).
  "calendar": {
    // The CalDAV server (the calendar is found from there).
    // "url": ""
    // The login.
    // "user": ""
    // The password. (secret)
    // "password": ""
    // Which calendar, if the account has several (default: the first that holds events).
    // "name": ""
    // Minutes before an event to remind you (unless it has its own reminder).
    // "reminderMinutes": 15
    // How often to check the calendar for changes.
    // "pollSeconds": 120
  }
}
