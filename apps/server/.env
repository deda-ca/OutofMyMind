# Copy to .env.local to override locally.
HOST=127.0.0.1
PORT=5180
AUDIOCPP_URL=http://127.0.0.1:5552
# Browser origins allowed to call the API (comma-separated). The client is served over HTTPS.
# Add this machine's LAN address in .env.local to use Jarvis from a phone, e.g. https://192.168.1.50:5173
ALLOWED_ORIGINS=https://127.0.0.1:5173,https://localhost:5173

# Database and audio archive (relative to apps/server).
DATA_DIR=data

# Voiceprint model for speaker recognition (npm run fetch-models).
VOICEPRINT_MODEL=models/3dspeaker_speech_campplus_sv_en_voxceleb_16k.onnx

# Assistant LLM (llama.cpp llama-server, OpenAI-compatible).
LLM_URL=http://127.0.0.1:5550
LLM_MODEL=Qwen3.6-35B-A3B
# Your name, so Jarvis knows who it works for (optional; set it in .env.local).
OWNER_NAME=
# Jarvis's voice: text-to-speech model and voice on audio.cpp.
TTS_MODEL=Qwen3-TTS
TTS_VOICE=jarvis

# Nous Hermes Agent API server (the "Hermes" brain). Enable it in ~/.hermes/.env (API_SERVER_ENABLED=true, API_SERVER_KEY=...),
# and put that key here as HERMES_API_KEY in .env.local.
HERMES_URL=http://127.0.0.1:8642
HERMES_MODEL=hermes-agent
