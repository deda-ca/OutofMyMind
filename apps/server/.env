# Copy to .env.local to override locally.
HOST=127.0.0.1
PORT=5180
AUDIOCPP_URL=http://127.0.0.1:5552
# Browser origins allowed to call the API (comma-separated).
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Database and audio archive (relative to apps/server).
DATA_DIR=data

# Voiceprint model for speaker recognition (npm run fetch-models).
VOICEPRINT_MODEL=models/3dspeaker_speech_campplus_sv_en_voxceleb_16k.onnx
