{
  "name": "jarvis-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch src/main.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "libopus-wasm": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ogg-opus-decoder": "^1.7.5",
    "typescript": "^7.0.2"
  }
}
