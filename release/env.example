# Jarvis configuration: copy to .env (or .env.local, which wins) next to the
# binary, in the folder you start it from. Every setting of apps/server/.env
# works here too; relative paths are relative to that folder.

# Where it listens. 0.0.0.0 to reach it from other devices (your phone).
HOST=127.0.0.1
PORT=5180

# HTTPS: "self-signed" (made once in data/tls; each device trusts it once) or "off".
# Or your own certificate: TLS_CERT=/path/cert.pem and TLS_KEY=/path/key.pem
TLS=self-signed

# Other browser origins allowed to call the API (comma-separated). The web
# client this binary serves is always allowed; this is for a separate one.
# ALLOWED_ORIGINS=https://example.lan:5173

# Database, audio archive, workspace (private: back it up, never publish it).
DATA_DIR=data
# The plugins (the LLM's tools); written the first time if it doesn't exist.
MCP_CONFIG=mcp.json

# Speech (audio.cpp) and the assistant's LLM (llama.cpp llama-server).
AUDIOCPP_URL=http://127.0.0.1:5552
LLM_URL=http://127.0.0.1:5454
LLM_MODEL=Assistant
# LLM_API_KEY=
# on if the model can see images (llama.cpp with its --mmproj): photos you send are shown to it.
# LLM_VISION=on

# Voiceprint model for speaker recognition: ./jarvis fetch-models
VOICEPRINT_MODEL=models/3dspeaker_speech_campplus_sv_en_voxceleb_16k.onnx

# Your name, so Jarvis knows who it works for.
OWNER_NAME=
TTS_MODEL=Qwen3-TTS
TTS_VOICE=jarvis

# Scripts and services run on Node 24 (its permission model is half their
# sandbox): the first node on PATH, or this one.
# JARVIS_NODE=/usr/local/bin/node

# Telegram (docs/telegram.md): chat with Jarvis from your phone, and get its
# messages there. A bot from @BotFather, used by Jarvis alone; your chat id.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_CHAT_ID=

# Email (docs/email.md): the inbox Jarvis watches and sends from. Quote a password with # in it.
# EMAIL_IMAP_HOST=mail.example.com
# EMAIL_SMTP_HOST=mail.example.com
# EMAIL_USER=me@example.com
# EMAIL_PASSWORD='…'

# Calendar (docs/calendar.md): a CalDAV calendar.
# CALENDAR_URL=https://mail.example.com:2080/
# CALENDAR_USER=me@example.com
# CALENDAR_PASSWORD='…'
